{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "go4taste-ads/inline-banner",
	"version": "1.0.0",
	"title": "Go4Taste Inline Banner",
	"category": "widgets",
	"icon": "megaphone",
	"description": "Display 1-3 product ads inline within content.",
	"textdomain": "go4taste-ads",
	"keywords": [ "ads", "product", "banner", "go4taste" ],
	"attributes": {
		"products": {
			"type": "array",
			"default": []
		},
		"mobileLayout": {
			"type": "string",
			"default": "column",
			"enum": [ "column", "carousel", "single" ]
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
