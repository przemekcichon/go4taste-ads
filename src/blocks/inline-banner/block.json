{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "go4taste-ads/inline-banner",
	"version": "1.0.0",
	"title": "Go4Taste Inline Banner",
	"category": "widgets",
	"icon": "megaphone",
	"description": "Display 1-3 product ads inline within content.",
	"textdomain": "go4taste-ads",
	"keywords": [ "ads", "product", "banner", "go4taste" ],
	"attributes": {
		"products": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"id": { "type": "string" },
					"name": { "type": "string" },
					"picture": { "type": "string" },
					"price": { "type": "string" },
					"price_without_reduction": { "type": "string" },
					"category": { "type": "string" }
				}
			}
		},
		"mobileLayout": {
			"type": "string",
			"default": "column",
			"enum": [ "column", "carousel", "single" ]
		},
		"productsGap": {
			"type": "string",
			"default": ""
		},
		"productsWidth": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": false,
			"gradients": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
